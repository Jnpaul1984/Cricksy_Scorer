# Backend app DB URL (async SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:RubyAnita2018@localhost:5555/cricksy_scorer

# Use in-memory DB mode for tests (set to 1 to bypass Postgres in tests)
CRICKSY_IN_MEMORY_DB=0

# Optional logging level for app
LOG_LEVEL=INFO

# Exact trusted hosts for organization logo images (comma-separated; no wildcard subdomains)
CRICKSY_ORGANIZATION_LOGO_ALLOWED_HOSTS=cdn.example.com,cricksy-ai.com,www.cricksy-ai.com,cricksy-ai.web.app,cricksy-ai-web.app
